# GEMINI_API_KEY: Fallback AI summarization provider
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Primary free LLM key for note summarization (from https://openrouter.ai)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Database Configuration (for standalone FastAPI backend)
# Zero-setup mode: leave MYSQL_PASSWORD blank or USE_SQLITE_FALLBACK=true to use local notes.db
USE_SQLITE_FALLBACK="true"
DATABASE_URL="sqlite:///./notes.db"

# Real MySQL Configuration (Optional)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="notes_db"
